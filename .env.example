# Copy to .env at the repo root, edit, then `make bootstrap`. docker-compose
# picks .env up automatically. Production deployments must NEVER use the
# development defaults (rotated weak HMAC secret, ephemeral signing key).

VAULTSCAN_ENV=development

# ----- Host ports ------------------------------------------------------------
# Override any of these if you have another stack already bound to the
# default. Example: VAULTSCAN_OPENSEARCH_PORT=19200 make bootstrap
VAULTSCAN_PORTAL_PORT=5173
VAULTSCAN_API_PORT=8080
VAULTSCAN_AGENT_GATEWAY_PORT=8443
VAULTSCAN_KEYCLOAK_PORT=8081
VAULTSCAN_POSTGRES_PORT=5432
VAULTSCAN_OPENSEARCH_PORT=9200
VAULTSCAN_MINIO_PORT=9000
VAULTSCAN_MINIO_CONSOLE_PORT=9001
VAULTSCAN_NATS_PORT=4222
VAULTSCAN_NATS_MON_PORT=8222

# ----- Backend URLs (used by host-side tools and local API runs) -----------
VAULTSCAN_DATABASE_URL=postgres://vaultscan:vaultscan@localhost:5432/vaultscan?sslmode=disable
VAULTSCAN_OPENSEARCH_URL=http://localhost:9200
VAULTSCAN_OBJECT_STORE_URL=http://localhost:9000
VAULTSCAN_OBJECT_STORE_KEY=vaultscan
VAULTSCAN_OBJECT_STORE_SECRET=vaultscan-dev-secret
VAULTSCAN_KEYCLOAK_ISSUER=http://localhost:8081/realms/vaultscan
VAULTSCAN_KEYCLOAK_AUDIENCE=vaultscan-portal

# ----- Secrets (REQUIRED — generate fresh values per-environment) ---------
# Both values must be set; docker-compose will refuse to start without
# them. The repo NEVER ships working defaults; copy-paste of a committed
# default into production would be a credential leak.
#
# Generate with:
#   VAULTSCAN_JWT_SECRET=$(openssl rand -base64 48)
#   VAULTSCAN_EVIDENCE_MASTER_KEY=$(openssl rand -base64 32)
#
# HS256 secret used by /api/v1/auth/dev-token. Production uses Keycloak.
VAULTSCAN_JWT_SECRET=

# AES-256 master key (base64, 32 bytes) used to envelope-encrypt
# evidence at rest. Rotating this requires re-encrypting existing
# evidence — coordinate with ops via the KEK-DEK rotation runbook.
VAULTSCAN_EVIDENCE_MASTER_KEY=

# RSA private key (PEM) used to sign scan job manifests dispatched to agents.
# Leave blank in dev to auto-generate an ephemeral key.
VAULTSCAN_JOB_SIGNING_KEY=

# ----- Misc ----------------------------------------------------------------
VAULTSCAN_RATE_LIMIT_RPS=100
VAULTSCAN_RATE_LIMIT_WINDOW_SEC=60
VAULTSCAN_RATE_LIMIT_TENANT_MULTIPLIER=10
# memory (default; in-proc bucket) | redis (production; needs RATE_LIMIT_REDIS_ADDR)
VAULTSCAN_RATE_LIMIT_BACKEND=memory
VAULTSCAN_RATE_LIMIT_REDIS_ADDR=
VAULTSCAN_EMERGENCY_STOP_MAX_LATENCY=30
VAULTSCAN_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Multi-region / data residency ---------------------------------------
# Deployment-zone code (ae|eu|uk|in|us|sg|au|jp). Leave empty in dev for
# the residency gate to no-op. Production pods must set this so tenants
# pinned to a different region get refused with 451.
VAULTSCAN_REGION=

# ----- Read-replica (optional) --------------------------------------------
# Empty in dev — dashboards route to the primary. Production sets this
# to a streaming-replica DSN; the API also runs SET default_transaction_
# read_only=on on every replica conn so an accidental write fails loud.
VAULTSCAN_DATABASE_REPLICA_URL=

# ----- Inbound webhook signing --------------------------------------------
# true (production default) = refuse any inbound callback without a
# valid HMAC. false = allow during dev or initial wire-up while
# operators populate per-integration signing secrets.
VAULTSCAN_REQUIRE_INBOUND_SIG=false

# ----- Supply-chain image signature gating --------------------------------
# Production default true; dev typically uses local images so leave off.
VAULTSCAN_REQUIRE_SIGNED_IMAGES=false

# ----- Audit export hard cap (rows) ---------------------------------------
# A platform admin pulling 10M+ rows can OOM the API; this caps any
# single /api/v1/audit/export request. Override per-request via ?max=.
VAULTSCAN_AUDIT_EXPORT_HARD_CAP=10000000

# ----- DEK rotation (cron-runner) -----------------------------------------
# Days between forced per-tenant DEK rotations. 90 = SOC2/ISO27001 target.
VAULTSCAN_DEK_ROTATION_DAYS=90
# Max objects re-wrapped per cron tick after a rotation. Bounded so a
# tenant with millions of evidence rows gets chewed through over hours.
VAULTSCAN_DEK_REWRAP_BATCH=500

# ----- Tracing (OpenTelemetry) --------------------------------------------
# Empty = no-op tracer (zero overhead). Set "otlp" + endpoint to push
# spans to an OTel collector.
VAULTSCAN_OTEL_EXPORTER=
VAULTSCAN_OTEL_ENDPOINT=

# ----- API public URL (used by scanner-worker bootstrap) ------------------
# Compose stack default talks to the api service via service-DNS.
VAULTSCAN_API_PUBLIC_URL=http://api:8080

# ----- Cron-runner admin port (host-side override) ------------------------
VAULTSCAN_CRON_ADMIN_PORT=9091
