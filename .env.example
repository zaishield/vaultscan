# Copy to .env, edit, then `make up`. Production deployments must NEVER use
# the development defaults (rotated weak HMAC secret, ephemeral signing key).

VAULTSCAN_ENV=development
VAULTSCAN_DATABASE_URL=postgres://vaultscan:vaultscan@localhost:5432/vaultscan?sslmode=disable
VAULTSCAN_OPENSEARCH_URL=http://localhost:9200
VAULTSCAN_OBJECT_STORE_URL=http://localhost:9000
VAULTSCAN_OBJECT_STORE_KEY=vaultscan
VAULTSCAN_OBJECT_STORE_SECRET=vaultscan-dev-secret
VAULTSCAN_KEYCLOAK_ISSUER=http://localhost:8081/realms/vaultscan
VAULTSCAN_KEYCLOAK_AUDIENCE=vaultscan-portal

# Dev-only HS256 secret used by /api/v1/auth/dev-token. Production uses
# Keycloak issuer keys.
VAULTSCAN_JWT_SECRET=dev-only-shared-secret-change-me

# AES-256 master key used to envelope-encrypt evidence at rest. Base64.
VAULTSCAN_EVIDENCE_MASTER_KEY=ZGV2LWV2aWRlbmNlLW1hc3Rlci1rZXktY2hhbmdlLW1lLTAwMDAwMDA=

# RSA private key (PEM) used to sign scan job manifests dispatched to agents.
# Leave blank in dev to auto-generate an ephemeral key.
VAULTSCAN_JOB_SIGNING_KEY=

VAULTSCAN_RATE_LIMIT_RPS=100
VAULTSCAN_EMERGENCY_STOP_MAX_LATENCY=30
VAULTSCAN_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
